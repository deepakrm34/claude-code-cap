{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "includeCoAuthoredBy": true,
  "env": {
    "FORCE_COLOR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run typecheck)",
      "Bash(npm run type-check)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --cached)",
      "Bash(git log --oneline -20)"
    ],
    "deny": [
      "Read(**/.env)"
    ]
  }
}
